# local: browser-only; cloudbase: authenticated workspace; github: public data + owner-authorized writes
VITE_DATA_MODE=local
# Public environment identifier, NOT a Tencent Cloud secret
VITE_CLOUDBASE_ENV_ID=
# GitHub public JSON repository settings (only used with VITE_DATA_MODE=github)
VITE_GITHUB_REPOSITORY=owner/repository
VITE_GITHUB_BRANCH=main
VITE_GITHUB_DATA_PATH=data/workspace.json
VITE_GITHUB_EDITOR_LOGIN=owner
# Use / for local/Vercel root hosting; use ./ for project sites hosted under a subpath.
VITE_BASE_PATH=/
# Never put SecretId, SecretKey, passwords or wecom credentials in VITE_*.
# Never put a GitHub access token in VITE_*; the owner enters a scoped token in the app.
